{{$u := .Channel.OwnerID}}
{{if eq $u 204255221017214977}}
{{$m := getMessage .Channel.ID .Channel.ID}}
{{if $m}}
{{$h := index (split $m.Content "\n") 0}}
{{if in (lower $h) "post opened by"}}
{{$i := reFind `\d{16,20}` $h}}
{{if $i}}
{{$u = toInt $i}}
{{end}}
{{end}}
{{end}}
