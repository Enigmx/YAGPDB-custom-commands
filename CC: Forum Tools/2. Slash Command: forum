{{if eq .SubCommand "search"}}
{{$ch := getChannel (.Options.Get "forum").ID}}
{{$n := lower (.Options.Get "query")}}
{{if not $ch}}
No forum channel found.
{{ephemeralResponse}}
{{return}}
{{end}}
{{if not $ch.IsForum}}
That channel is not a forum.
{{ephemeralResponse}}
{{return}}
{{end}}
{{$c := ""}}
{{range .Guild.Threads}}
{{if and (eq $ch.ID .ParentID) (in (lower .Name) $n)}}
{{if ge (len $c) 3950}}
{{$c = print $c "\n\nAnd some more posts which I can't show due to the character limit..."}}
{{break}}
{{end}}
{{$c = print $c "\n\n<#" .ID "> - " .Name ", opened by <@" .OwnerID ">"}}
{{end}}
{{end}}
{{if not $c}}
Nothing found...
{{ephemeralResponse}}
{{return}}
{{end}}
{{$d := cslice}}
{{range $ch.AvailableTags}}
