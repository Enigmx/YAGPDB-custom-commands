{{if eq .CustomID "forumToolsFilter1" "forumToolsFilter2"}}
{{$a := getChannel (toInt (reFind `\d+` (index .Message.Embeds 0).Title))}}
{{$b := trimSpace (index (slice (split (index .Message.Embeds 0).Title " ") 3) 1)}}
{{$c := ""}}
{{range .Guild.Threads}}
{{if and (eq $a.ID .ParentID) (in (lower .Name) $b)}}
{{$e := false}}
{{range .AppliedTags}}
{{if in $.Values (str .)}}
{{$e = true}}
{{end}}
{{end}}
{{if and (in $.CustomID "2") ($e) $.Values}}
{{continue}}
{{else if (and (in $.CustomID "1") $.Values (not $e))}}
{{continue}}
{{end}}
{{if ge (len $c) 3950}}
{{$c = print $c "\n\nAnd some more posts which I can't show due to the character limit..."}}
{{break}}
{{end}}
{{$c = print $c "\n\n<#" .ID "> - " .Name ", opened by <@" .OwnerID ">"}}
{{end}}
{{end}}
{{if not $c}}
Nothing found...
{{return}}
{{end}}
{{$d := cslice}}
{{range $a.AvailableTags}}
{{$d = $d.Append (sdict "label" .Name "value" (str .ID))}}
{{end}}
{{try}}
{{updateMessage (complexMessageEdit "menus" (cslice (sdict "type" "text" "placeholder" "Filter by tags" "custom_id" "forumToolsFilter1" "options" $d "min_values" 0 "max_values" (len $d)) (sdict "type" "text" "placeholder" "Filter out tags" "custom_id" "forumToolsFilter2" "options" $d "max_values" (len $d))) "embed" (cembed "title" (print "Search results in <#" $a.ID ">: " $b) "description" $c))}}
{{catch}}
{{editMessage nil nil (complexMessageEdit "menus" (cslice (sdict "type" "text" "placeholder" "Filter by tags" "custom_id" "forumToolsFilter1" "options" $d "min_values" 0 "max_values" (len $d)) (sdict "type" "text" "placeholder" "Filter out tags" "custom_id" "forumToolsFilter2" "options" $d "max_values" (len $d))) "embed" (cembed "title" (print "Search results in <#" $a.ID ">: " $b) "description" $c))}}
{{end}}
{{return}}
{{end}}
{{if eq .CustomID "forumToolsModifyTags"}}
{{$db := (dbGet 0 "forumTools").Value}}
{{if and (not (in .Member.Roles (index $db 1))) (not (eq .User.ID .Channel.OwnerID))}}
Only moderators of the server and the post creator can use this tool :(
{{ephemeralResponse}}
{{return}}
{{end}}
{{editThread .Channel.ID (sdict "tags" .Values)}}
{{try}}
{{updateMessage (complexMessageEdit "content" "Done! modified this post's tags.")}}
{{catch}}
{{editMessage $.Channel.ID $.Message.ID (complexMessageEdit "content" "Done! modified this post's tags.")}}
{{end}}
{{return}}
{{end}}
