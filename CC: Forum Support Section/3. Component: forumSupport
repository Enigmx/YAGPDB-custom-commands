{{end}}
{{if $x}}
{{sendModal (sdict "custom_id" "forumSupportAdd" "title" "Add support option" "components" (cslice (clabel "label" "Option name" "component" (ctextInput "max_length" 100 "custom_id" "n" "placeholder" "Enter the option name" "required" true "max_length" 100)) (clabel "label" "Option description" "component" (ctextInput "max_length" 100 "custom_id" "d" "placeholder" "Enter the option description" "required" true "max_length" 100)) (clabel "label" "If selected, add this tag:" "component" (cmenu "placeholder" "Select a forum tag" "custom_id" "t" "type" "text" "options" $x))))}}
{{else}}
{{sendModal (sdict "custom_id" "forumSupportAdd" "title" "Add support option" "components" (cslice (clabel "label" "Option name" "component" (ctextInput "custom_id" "n" "placeholder" "Enter the option name" "required" true "max_length" 100)) (clabel "label" "Option description" "component" (ctextInput "custom_id" "d" "placeholder" "Enter the option description" "required" true "max_length" 100))))}}
{{end}}
{{return}}
{{end}}
