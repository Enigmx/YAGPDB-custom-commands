{{if and (eq .CustomID "birthdayConfigRemove") $adm}}
{{sendModal (sdict
"custom_id" "birthdayConfigRemove"
"title" "Remove from notifications"
"components" (cslice
(clabel "label" "User ID" "component" (ctextInput "custom_id" "u" "type" 1 "required" true))))}}
{{return}}
{{end}}

{{if and (eq .CustomID "birthdayConfigAdd") $adm}}
{{execCC $db.ccid nil 0 3}}
{{return}}
{{end}}

{{if and $adm (eq .CustomID "birthdayConfigOptIn")}}
{{$a := $db.tag}}
{{if not (in $a .User.ID)}}
{{$a = $a.Append .User.ID}}
{{end}}
{{$db.Set "tag" $a}}
{{dbSet 0 "birthdayTracker" $db}}
Added you to notifications
{{ephemeralResponse}}
{{return}}
{{end}}

{{if and $adm (eq .CustomID "birthdayConfigOptOut")}}
{{$a := cslice}}
{{range $db.tag}}
{{if ne . $.User.ID}}
{{$a = $a.Append .}}
{{end}}
{{end}}
{{$db.Set "tag" $a}}
{{dbSet 0 "birthdayTracker" $db}}
Removed you from notifications
{{ephemeralResponse}}
{{return}}
{{end}}

{{if and (eq .CustomID "birthdayConfigChannel") $adm}}
{{$db.Set "channel" (toInt (index .Values 0))}}
{{dbSet 0 "birthdayTracker" $db}}
{{execCC $db.ccid nil 0 1}}
{{return}}
{{end}}

{{if and (eq .CustomID "birthdayConfigRoles") $adm}}
{{$db.Set "roles" .Values}}
{{dbSet 0 "birthdayTracker" $db}}
{{execCC $db.ccid nil 0 1}}
{{return}}
{{end}}

{{if and (eq .CustomID "birthdayConfigList") $adm}}
{{execCC .CCID nil 0 1}}
{{return}}
{{end}}

{{if and (eq .CustomID "birthdayConfigSelect") $adm}}
{{execCC $db.ccid nil 0 1}}
{{return}}
{{end}}

{{if and (in .CustomID "birthdayConfigPage") $adm}}
{{$p := toInt (reFind `\d+` .CustomID)}}
{{execCC .CCID nil 0 $p}}
{{return}}
{{end}}

{{if and (eq .CustomID "birthdayConfigPublic") $adm}}
{{execCC $db.ccid nil 0 .Values}}
Sending messages...
{{return}}
{{end}}

{{if eq .CustomID "birthdayPublicAdd"}}
{{execCC $db.ccid nil 0 2}}
{{return}}
{{end}}

{{if and (eq .CustomID "birthdayConfigRemoveUser") $adm}}
