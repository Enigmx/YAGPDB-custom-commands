{{return}}
{{end}}

{{if eq .CustomID "birthdayNotificationConclude"}}
{{$m := getMessage .Channel.ID .Message.ID}}
{{$e := structToSdict (index $m.Embeds 0)}}
{{$e.Set "color" 0x00FF00}}
{{updateMessage (complexMessageEdit
"content" (print $m.Content "\n\n" .User.Mention " marked as concluded")
"embed" (cembed $e)
"buttons" (cslice (sdict
"disabled" true
"style" "success"
"custom_id" "birthdayNotificationConclude"
"emoji" (sdict "id" "1526085926340788375"))))}}
{{return}}
{{end}}
