{{$db := (dbGet 0 "birthdayTracker").Value}}
{{$adm := false}}
{{range $db.a}}
{{if in $.Member.Roles (toInt .)}}
{{$adm = true}}
{{end}}
{{end}}

{{if .ExecData}}
{{if eq .ExecData 1}}
{{$a := ""}}
{{range (cslice (sdict "n" "January" "k" "january") (sdict "n" "February" "k" "february") (sdict "n" "March" "k" "march"))}}
{{$l := $db.list.Get .k}}
{{$x := ""}}
{{range $l}}
{{if $x}}
{{$x = print $x ", "}}
{{end}}
{{$x = print $x "<@" .u "> (" .d ")"}}
{{end}}
{{if not $x}}
{{$x = "None"}}
{{end}}
{{$a = print $a "**" .n "**: " $x "\n\n"}}
{{end}}
{{$b1 := cbutton "emoji" (sdict "id" "1527138600414875678") "custom_id" "birthdayConfigSelect" "style" "grey"}}
{{$b2 := cbutton "emoji" (sdict "id" "1527450008197009498") "custom_id" "birthdayConfigAdd" "style" "green"}}
{{$b3 := cbutton "emoji" (sdict "id" "1527457280017043626") "custom_id" "birthdayConfigRemoveUser" "style" "red"}}
{{$b4 := cbutton "emoji" (sdict "id" "1548876258023186523") "custom_id" "birthdayConfigPage4" "style" "grey"}}
{{$b5 := cbutton "emoji" (sdict "id" "1548876309256474664") "custom_id" "birthdayConfigPage2" "style" "grey"}}
{{$v := componentBuilder}}
{{$v.Add "text" "# Birthday list"}}
{{$v.Add "separator" false}}
{{$v.Add "text" $a}}
{{$v.Add "separator" false}}
{{$v.Add "buttons" (cslice $b4 $b2 $b1 $b3 $b5)}}
{{$v = componentBuilder "container" (sdict "components" $v)}}
{{$v.Add "allowed_mentions" (sdict "parse" (cslice))}}
{{updateMessage $v}}
{{return}}
{{end}}

